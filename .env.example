# Copy to an untracked private environment file only after review.
# These values are examples, not ready-to-use credentials.
MYSQL_DATABASE=livestock_demo_l7_example
MYSQL_USER=livestock_app
MYSQL_PASSWORD=replace-with-random-value
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-value

# Generate a random secret locally; never commit the replaced value.
SECRET_KEY=replace-with-at-least-32-random-bytes

# Optional Gemini API integration. Keep this key private and out of Git/logs.
AGENT_MODE=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Leave empty until the newly created private MySQL container is verified.
DEMO_DATABASE_SERVER_UUID=
DEMO_DATABASE_ATTESTATION=
